## SQL Queries

### 1. Data Extraction & Aggregation

#### Query 1: Customer Segmentation Analysis
```sql
SELECT 
    customer_id,
    segment,
    COUNT(order_id) as total_orders,
    SUM(order_amount) as total_revenue,
    AVG(order_amount) as avg_order_value,
    MAX(order_date) as last_purchase_date,
    DATEDIFF(DAY, MAX(order_date), GETDATE()) as days_since_purchase
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
WHERE order_date >= DATEADD(YEAR, -1, GETDATE())
GROUP BY customer_id, segment
HAVING COUNT(order_id) > 0
ORDER BY total_revenue DESC;
```

#### Query 2: Product Performance Ranking
```sql
SELECT 
    product_id,
    product_name,
    category,
    SUM(quantity_sold) as total_units_sold,
    SUM(revenue) as total_revenue,
    COUNT(DISTINCT order_id) as transaction_count,
    AVG(unit_price) as avg_selling_price,
    ROUND(SUM(revenue) / NULLIF(SUM(quantity_sold), 0), 2) as effective_price,
    RANK() OVER (PARTITION BY category ORDER BY SUM(revenue) DESC) as category_rank
FROM sales s
JOIN products p ON s.product_id = p.product_id
WHERE sale_date >= DATEADD(MONTH, -3, GETDATE())
GROUP BY product_id, product_name, category
ORDER BY total_revenue DESC;
```

#### Query 3: Customer Lifetime Value (CLV) Calculation
```sql
WITH customer_metrics AS (
    SELECT 
        customer_id,
        MIN(order_date) as first_purchase,
        MAX(order_date) as last_purchase,
        DATEDIFF(DAY, MIN(order_date), MAX(order_date)) as customer_lifecycle_days,
        COUNT(DISTINCT order_date) as purchase_frequency,
        SUM(order_amount) as total_revenue,
        AVG(order_amount) as avg_order_value
    FROM orders
    GROUP BY customer_id
)
SELECT 
    customer_id,
    first_purchase,
    last_purchase,
    customer_lifecycle_days,
    purchase_frequency,
    total_revenue,
    avg_order_value,
    CASE 
        WHEN customer_lifecycle_days = 0 THEN avg_order_value
        ELSE (avg_order_value * purchase_frequency * (365.0 / NULLIF(customer_lifecycle_days, 0)))
    END as estimated_annual_clv,
    NTILE(4) OVER (ORDER BY total_revenue) as revenue_quartile
FROM customer_metrics
WHERE total_revenue > 0
ORDER BY total_revenue DESC;
```

### 2. Time Series & Trends

#### Query 4: Monthly Revenue Trend with Growth Rate
```sql
WITH monthly_revenue AS (
    SELECT 
        DATEFROMPARTS(YEAR(order_date), MONTH(order_date), 1) as month,
        SUM(order_amount) as monthly_revenue,
        COUNT(DISTINCT order_id) as order_count,
        COUNT(DISTINCT customer_id) as unique_customers
    FROM orders
    WHERE order_date >= DATEADD(YEAR, -1, GETDATE())
    GROUP BY YEAR(order_date), MONTH(order_date)
)
SELECT 
    month,
    monthly_revenue,
    order_count,
    unique_customers,
    LAG(monthly_revenue) OVER (ORDER BY month) as previous_month_revenue,
    ROUND((monthly_revenue - LAG(monthly_revenue) OVER (ORDER BY month)) / LAG(monthly_revenue) OVER (ORDER BY month) * 100, 2) as mom_growth_percent,
    AVG(monthly_revenue) OVER (ORDER BY month ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) as moving_avg_4m
FROM monthly_revenue
ORDER BY month DESC;
```

### 3. Cohort Analysis

#### Query 5: Cohort Retention Analysis
```sql
WITH first_purchase AS (
    SELECT 
        customer_id,
        DATEFROMPARTS(YEAR(MIN(order_date)), MONTH(MIN(order_date)), 1) as cohort_month
    FROM orders
    GROUP BY customer_id
),
purchase_months AS (
    SELECT 
        fp.customer_id,
        fp.cohort_month,
        DATEFROMPARTS(YEAR(o.order_date), MONTH(o.order_date), 1) as purchase_month,
        DATEDIFF(MONTH, fp.cohort_month, DATEFROMPARTS(YEAR(o.order_date), MONTH(o.order_date), 1)) as months_since_cohort
    FROM orders o
    JOIN first_purchase fp ON o.customer_id = fp.customer_id
)
SELECT 
    cohort_month,
    months_since_cohort,
    COUNT(DISTINCT customer_id) as customer_count,
    ROUND(COUNT(DISTINCT customer_id) * 100.0 / (SELECT COUNT(DISTINCT customer_id) FROM first_purchase WHERE cohort_month = pm.cohort_month), 2) as retention_percent
FROM purchase_months pm
GROUP BY cohort_month, months_since_cohort
ORDER BY cohort_month DESC, months_since_cohort ASC;
```

