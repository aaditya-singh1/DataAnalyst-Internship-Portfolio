### 4. Time Series Decomposition
```python
from statsmodels.tsa.seasonal import seasonal_decompose

# Prepare time series data
ts_data = df.set_index('order_date').resample('D')['order_amount'].sum().sort_index()

# Decomposition
decomposition = seasonal_decompose(ts_data, model='additive', period=30)

fig, axes = plt.subplots(4, 1, figsize=(14, 10))
ts_data.plot(ax=axes[0], title='Original')
decomposition.trend.plot(ax=axes[1], title='Trend')
decomposition.seasonal.plot(ax=axes[2], title='Seasonality')
decomposition.resid.plot(ax=axes[3], title='Residuals')
plt.tight_layout()
plt.savefig('time_series_decomposition.png', dpi=300, bbox_inches='tight')
plt.show()

print("\nTime Series Components Saved")
```

### 5. Clustering Analysis
```python
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans

# Prepare data for clustering
cluster_features = df.groupby('customer_id').agg({
    'order_amount': ['sum', 'mean', 'count'],
    'order_date': lambda x: (df['order_date'].max() - x.max()).days
}).reset_index()

cluster_features.columns = ['customer_id', 'total_spending', 'avg_order', 'order_count', 'recency']

# Standardize features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(cluster_features[['total_spending', 'order_count', 'recency']])

# K-Means Clustering
kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
cluster_features['cluster'] = kmeans.fit_predict(X_scaled)

# Visualize clusters
plt.figure(figsize=(10, 6))
scatter = plt.scatter(cluster_features['total_spending'], 
                     cluster_features['order_count'], 
                     c=cluster_features['cluster'], 
                     cmap='viridis', 
                     s=100, 
                     alpha=0.6)
plt.xlabel('Total Spending ($)')
plt.ylabel('Order Count')
plt.title('Customer Clustering Analysis')
plt.colorbar(scatter, label='Cluster')
plt.savefig('customer_clusters.png', dpi=300, bbox_inches='tight')
plt.show()

print("\nCluster Summary:")
print(cluster_features.groupby('cluster')[['total_spending', 'order_count', 'recency']].mean())
```

